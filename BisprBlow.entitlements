<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime blocks the mic without this, and a hardened runtime is what
	     notarization requires. Not the App Sandbox: the app needs an event tap and
	     arbitrary-app text insertion, neither of which survives sandboxing. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
