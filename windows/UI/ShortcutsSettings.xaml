<!-- Editor for one action's bindings: remove, record another, reset. Fixed size, deliberately: every part of
     it grows and shrinks as you use it, and a window that resizes under the pointer moves the button you
     were reaching for. The list is the one part that can overflow, so it is the one part that scrolls. -->
<Window x:Class="BisprBlow.ShortcutSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shortcut" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bj.Cream}" FontFamily="{DynamicResource Bj.Font}"
        FontSize="13" Foreground="{DynamicResource Bj.Ink}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Width="400" Height="300" Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- One line of blurb, reserved: pinning it keeps the card below at the same height in every action. -->
    <StackPanel>
      <TextBlock x:Name="ActionTitle" Style="{StaticResource Bj.H2}"/>
      <TextBlock x:Name="Blurb" Style="{StaticResource Bj.Caption}" Foreground="{DynamicResource Bj.InkTertiary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
    </StackPanel>

    <!-- The list is the control. Adding is its last row rather than a button below, so there is one place
         to click to change a binding. -->
    <Border Grid.Row="1" Style="{StaticResource Bj.Card}" Padding="6" Margin="0,14,0,14">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel x:Name="Rows"/>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2">
      <!-- Always present, dimmed when there is nothing to undo, so the footer never gains a control. -->
      <Button x:Name="Reset" Content="Reset" Style="{StaticResource Bj.LinkButton}" HorizontalAlignment="Left" Click="OnReset"/>
      <Button Content="Done" Style="{StaticResource Bj.PrimaryButton}" HorizontalAlignment="Right" IsDefault="True" Click="OnDone"/>
    </Grid>
  </Grid>
</Window>
