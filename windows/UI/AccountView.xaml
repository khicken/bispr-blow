<UserControl x:Class="BisprBlow.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BisprBlow">
  <!-- One control for the three places an account shows up, picked by Mode: Account is the Settings
       group, SignIn the sign-in form on its own, Team the create/join form or the team you are in. -->
  <Grid>

    <!-- Account: who is signed in, and the two backup switches. -->
    <StackPanel x:Name="AccountPanel" Visibility="Collapsed">
      <Grid Margin="11,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="AccountCircle" Margin="0,0,10,0"/>
        <TextBlock x:Name="EmailText" Grid.Column="1" Style="{DynamicResource Bj.Body}" FontWeight="Medium"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <Button x:Name="SignOutButton" Grid.Column="2" Content="Sign out" Style="{DynamicResource Bj.LinkButton}" Click="SignOut_Click"/>
      </Grid>
      <StackPanel x:Name="SignOutConfirm" Orientation="Horizontal" Margin="11,0,11,8" Visibility="Collapsed">
        <TextBlock Text="Backup stops until you sign in again." Style="{DynamicResource Bj.Caption}" VerticalAlignment="Center"/>
        <Button Content="Sign out" Style="{DynamicResource Bj.LinkButton}" Foreground="{DynamicResource Bj.Red}" Click="ConfirmSignOut_Click"/>
        <Button Content="Cancel" Style="{DynamicResource Bj.LinkButton}" Click="CancelSignOut_Click"/>
      </StackPanel>
      <Rectangle Style="{DynamicResource Bj.Divider}" Margin="11,3"/>
      <CheckBox x:Name="StatsRow" Style="{DynamicResource Bj.ToggleRow}" Content="Back up dictation stats"
                ToolTip="Syncs word counts for your team, never your words."
                IsChecked="{Binding SyncStats, Source={x:Static local:AppSettings.Shared}, Mode=TwoWay}"/>
      <CheckBox x:Name="TextsRow" Style="{DynamicResource Bj.ToggleRow}" Content="Back up dictation text"
                ToolTip="Saves your dictations. Only you can see them." Visibility="Collapsed"
                IsChecked="{Binding SyncTexts, Source={x:Static local:AppSettings.Shared}, Mode=TwoWay}"/>
    </StackPanel>

    <!-- SignIn: "sign in or create an account" is literally one call — RequestCodeAsync passes
         create_user, so there is no sign-up form to build. -->
    <StackPanel x:Name="SignInPanel" Visibility="Collapsed">
      <TextBlock x:Name="Blurb" Text="Sign in to back up stats and join a team." Style="{DynamicResource Bj.Caption}" Margin="0,0,0,10"/>
      <TextBlock x:Name="AuthNoteText" Style="{DynamicResource Bj.Micro}" Foreground="{DynamicResource Bj.Red}"
                 TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="EmailField" Style="{DynamicResource Bj.TextField}" Tag="you@company.com"/>
        <TextBox x:Name="CodeField" Grid.Column="1" Style="{DynamicResource Bj.TextField}" Tag="Code" Width="100"
                 Margin="8,0,0,0" Visibility="Collapsed"/>
        <Button x:Name="SubmitButton" Grid.Column="2" Style="{DynamicResource Bj.PrimaryButton}" Margin="8,0,0,0" Click="Submit_Click"/>
      </Grid>
      <StackPanel x:Name="CodeSentRow" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
        <TextBlock x:Name="CodeSentText" Style="{DynamicResource Bj.Micro}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Button x:Name="DifferentEmailButton" Content="Use a different email" Style="{DynamicResource Bj.LinkButton}" Click="BackToEmail_Click"/>
        <Button x:Name="ResendButton" Content="Resend" Style="{DynamicResource Bj.LinkButton}" Click="Resend_Click"/>
      </StackPanel>
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Rectangle Style="{DynamicResource Bj.Divider}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="or" Style="{DynamicResource Bj.Micro}" Foreground="{DynamicResource Bj.InkTertiary}" Margin="10,0"/>
        <Rectangle Grid.Column="2" Style="{DynamicResource Bj.Divider}" VerticalAlignment="Center"/>
      </Grid>
      <Button x:Name="GoogleButton" Style="{DynamicResource Bj.SecondaryButton}" Click="Google_Click">
        <StackPanel Orientation="Horizontal">
          <Image Source="{DynamicResource Bj.Logo.Google}" Width="14" Height="14" Margin="0,0,7,0"/>
          <TextBlock Text="Continue with Google"/>
        </StackPanel>
      </Button>
      <StackPanel x:Name="GoogleWait" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
        <TextBlock Text="Waiting for browser…" Style="{DynamicResource Bj.Micro}" VerticalAlignment="Center"/>
        <Button Content="Cancel" Style="{DynamicResource Bj.LinkButton}" Click="CancelGoogle_Click"/>
      </StackPanel>
      <TextBlock x:Name="SignInNote" Style="{DynamicResource Bj.Micro}" Foreground="{DynamicResource Bj.Red}"
                 TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
    </StackPanel>

    <!-- Team: the org you are in and who else is, or the one form to get into one. Joining is the
         common case, so starting a team is the quiet link. -->
    <StackPanel x:Name="TeamHost" Visibility="Collapsed">
      <StackPanel x:Name="JoinPanel">
        <TextBlock x:Name="JoinHeading" Style="{DynamicResource Bj.H2}" Margin="0,0,0,12"/>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="JoinCodeField" Style="{DynamicResource Bj.TextField}" Tag="Invite code"/>
          <TextBox x:Name="TeamNameField" Style="{DynamicResource Bj.TextField}" Tag="Team name" Visibility="Collapsed"/>
          <Button x:Name="JoinButton" Grid.Column="1" Style="{DynamicResource Bj.PrimaryButton}" Margin="8,0,0,0" Click="Join_Click"/>
        </Grid>
        <Button x:Name="CreatingToggle" HorizontalAlignment="Left" Style="{DynamicResource Bj.LinkButton}" Click="CreatingToggle_Click"/>
      </StackPanel>

      <StackPanel x:Name="TeamPanel">
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="OrgCircle" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
            <Button x:Name="OrgNameButton" Style="{DynamicResource Bj.RowButton}" HorizontalAlignment="Left" Padding="0,2"
                    ToolTip="Rename team" Click="Rename_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="OrgNameText" Style="{DynamicResource Bj.H2}"/>
                <TextBlock x:Name="PencilIcon" Text="&#xE70F;" Style="{DynamicResource Bj.Icon}" Margin="6,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <TextBox x:Name="RenameField" Style="{DynamicResource Bj.TextField}" Tag="Team name" Visibility="Collapsed"/>
            <TextBlock x:Name="MemberCount" Style="{DynamicResource Bj.Caption}" Margin="0,2,0,0"/>
          </StackPanel>
          <Button x:Name="LeaveButton" Grid.Column="2" Content="Leave team" Style="{DynamicResource Bj.LinkButton}" Click="Leave_Click"/>
        </Grid>
        <StackPanel x:Name="LeaveConfirm" Orientation="Horizontal" Margin="0,0,0,14" Visibility="Collapsed">
          <TextBlock Text="You will need a new invite to rejoin." Style="{DynamicResource Bj.Caption}" VerticalAlignment="Center"/>
          <Button Content="Leave team" Style="{DynamicResource Bj.LinkButton}" Foreground="{DynamicResource Bj.Red}" Click="ConfirmLeave_Click"/>
          <Button Content="Cancel" Style="{DynamicResource Bj.LinkButton}" Click="CancelLeave_Click"/>
        </StackPanel>
        <StackPanel x:Name="OwnerPanel">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InviteField" Style="{DynamicResource Bj.TextField}" Tag="Teammate's email"/>
            <Button x:Name="InviteButton" Grid.Column="1" Style="{DynamicResource Bj.SecondaryButton}" Margin="8,0,0,0" Click="Invite_Click"/>
          </Grid>
          <!-- The row is the copy button, like history rows. -->
          <Button x:Name="InviteCodeRow" Style="{DynamicResource Bj.RowButton}" Margin="0,10,0,0" Padding="12,10"
                  ToolTip="Copy invite code" Click="CopyCode_Click" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <!-- A code read out loud is easier to check in a face where I and l differ. -->
              <TextBlock x:Name="InviteCodeText" Style="{DynamicResource Bj.Body}" FontFamily="Consolas" FontWeight="SemiBold"/>
              <TextBlock x:Name="InviteForText" Grid.Column="1" Style="{DynamicResource Bj.Caption}" Margin="10,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="CopyText" Grid.Column="2" Style="{DynamicResource Bj.Caption}" FontWeight="Medium" VerticalAlignment="Center"/>
            </Grid>
          </Button>
        </StackPanel>
      </StackPanel>

      <TextBlock x:Name="TeamNote" Style="{DynamicResource Bj.Micro}" Foreground="{DynamicResource Bj.Red}"
                 TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
    </StackPanel>
  </Grid>
</UserControl>
