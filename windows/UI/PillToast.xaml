<Window x:Class="BisprBlow.PillToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BisprBlow" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        Width="420" Height="48" UseLayoutRounding="True" Focusable="False">
  <Grid>
    <!-- The capsule hugs the parked edge, so it lands against the pill rather than centred in a
         420pt window whose edges nobody can see. -->
    <Border x:Name="Capsule" Opacity="0" Visibility="Collapsed" MinHeight="26" Padding="12,0" CornerRadius="13"
            Background="{DynamicResource Bj.PillBackground}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            MouseEnter="Hovered" MouseLeave="Unhovered">
      <Border.Effect>
        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.3" Color="Black"/>
      </Border.Effect>
      <Border.RenderTransform><TranslateTransform x:Name="Lift" Y="6"/></Border.RenderTransform>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="MicGlyph" Text="&#xE720;" FontFamily="{StaticResource Bj.IconFont}" FontSize="{StaticResource Bj.SizeMicro}"
                   Foreground="White" Opacity="0.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="Message" FontFamily="{DynamicResource Bj.Font}" FontSize="{StaticResource Bj.SizeMicro}" FontWeight="Medium" Foreground="White"
                   Opacity="0.92" TextWrapping="Wrap" MaxWidth="340" MaxHeight="32" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"/>
        <Button x:Name="Action" Margin="6,0,0,0" Cursor="Hand" Focusable="False" Click="RunAction" VerticalAlignment="Center">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border CornerRadius="11" Background="#38FFFFFF" Padding="8,3">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Button.Template>
          <TextBlock x:Name="ActionLabel" FontFamily="{DynamicResource Bj.Font}" FontSize="{StaticResource Bj.SizeMicro}" FontWeight="SemiBold" Foreground="White"/>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</Window>
